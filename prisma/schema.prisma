// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Advocate {
  id                  Int      @id @default(autoincrement())
  barCouncilId        String   @unique @map("bar_council_id") @db.VarChar(50)
  fullName            String   @map("full_name") @db.VarChar(255)
  email               String?  @db.VarChar(255)
  phone               String?  @db.VarChar(20)
  photoUrl            String?  @map("photo_url") @db.Text
  enrollmentDate      DateTime? @map("enrollment_date") @db.Date
  experienceYears     Int?     @map("experience_years")
  gender              String?  @db.VarChar(20)
  bio                 String?  @db.Text
  chamberAddress      String?  @map("chamber_address") @db.Text
  chamberLat          Decimal? @map("chamber_lat") @db.Decimal(10, 8)
  chamberLng          Decimal? @map("chamber_lng") @db.Decimal(11, 8)
  consultationFeeMin  Int?     @map("consultation_fee_min")
  consultationFeeMax  Int?     @map("consultation_fee_max")
  isAcceptingCases    Boolean  @default(true) @map("is_accepting_cases")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  practiceAreas       AdvocatePracticeArea[]
  courtAdmissions     AdvocateCourtAdmission[]
  languages           AdvocateLanguage[]
  locations           AdvocateLocation[]
  education           Education[]

  @@index([fullName])
  @@index([barCouncilId])
  @@index([experienceYears])
  @@map("advocates")
}

model PracticeArea {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)

  advocates   AdvocatePracticeArea[]

  @@map("practice_areas")
}

model AdvocatePracticeArea {
  advocateId     Int          @map("advocate_id")
  practiceAreaId Int          @map("practice_area_id")
  isPrimary      Boolean      @default(false) @map("is_primary")

  advocate       Advocate     @relation(fields: [advocateId], references: [id], onDelete: Cascade)
  practiceArea   PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)

  @@id([advocateId, practiceAreaId])
  @@map("advocate_practice_areas")
}

model CourtLevel {
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(100)
  hierarchyLevel Int?     @map("hierarchy_level")

  advocates      AdvocateCourtAdmission[]

  @@map("court_levels")
}

model AdvocateCourtAdmission {
  advocateId    Int          @map("advocate_id")
  courtLevelId  Int          @map("court_level_id")
  admissionDate DateTime?    @map("admission_date") @db.Date

  advocate      Advocate     @relation(fields: [advocateId], references: [id], onDelete: Cascade)
  courtLevel    CourtLevel   @relation(fields: [courtLevelId], references: [id], onDelete: Cascade)

  @@id([advocateId, courtLevelId])
  @@map("advocate_court_admissions")
}

model Language {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)

  advocates AdvocateLanguage[]

  @@map("languages")
}

model AdvocateLanguage {
  advocateId       Int      @map("advocate_id")
  languageId       Int      @map("language_id")
  proficiencyLevel String?  @map("proficiency_level") @db.VarChar(50)

  advocate         Advocate @relation(fields: [advocateId], references: [id], onDelete: Cascade)
  language         Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([advocateId, languageId])
  @@map("advocate_languages")
}

model Location {
  id       Int      @id @default(autoincrement())
  name     String   @unique @db.VarChar(100)
  district String   @default("Sylhet") @db.VarChar(100)

  advocates AdvocateLocation[]

  @@map("locations")
}

model AdvocateLocation {
  advocateId Int      @map("advocate_id")
  locationId Int      @map("location_id")

  advocate   Advocate @relation(fields: [advocateId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([advocateId, locationId])
  @@map("advocate_locations")
}

model Education {
  id              Int      @id @default(autoincrement())
  advocateId      Int      @map("advocate_id")
  degree          String   @db.VarChar(255)
  institution     String   @db.VarChar(255)
  graduationYear  Int?     @map("graduation_year")
  specialization  String?  @db.VarChar(255)

  advocate        Advocate @relation(fields: [advocateId], references: [id], onDelete: Cascade)

  @@map("education")
}
